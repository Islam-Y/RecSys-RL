    {"name": "next-item-only", "reward": "raw_completion", "reward_weight": 0.0, "ce_weight": 1.0, "kl_beta_base": 0.0},
    {"name": "mixed-001", "reward": "raw_completion", "reward_weight": 1.0, "ce_weight": 0.001, "kl_beta_base": 0.1},
